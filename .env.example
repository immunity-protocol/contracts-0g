# Secrets are managed via `npx hardhat keystore set <KEY>` (Hardhat 3 keystore).
# This file documents the keys the project expects but is not loaded at runtime.

# 0G Galileo testnet RPC (default: https://evmrpc-testnet.0g.ai)
IMMUNITY_GALILEO_RPC=https://evmrpc-testnet.0g.ai

# Deployer private key (hex, 0x-prefixed, funded via https://cloud.google.com/application/web3/faucet/0g/galileo)
IMMUNITY_DEPLOYER_PK=0x...
